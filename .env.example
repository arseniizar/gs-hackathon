# =================================================================
#           ОСНОВНІ НАЛАШТУВАННЯ ДЛЯ ВСІХ СЕРВІСІВ
# =================================================================
# Середовище розробки (development, production)
NODE_ENV=development


# =================================================================
#           FRONTEND (React / Vite)
# =================================================================
# URL-адреси наших бекендів, до яких буде звертатися фронтенд.
# Префікс VITE_ обов'язковий, щоб Vite зробив ці змінні доступними в коді.

# URL для основного бекенду на Java Spring Boot
VITE_API_BASE_URL=http://localhost:8080/api

# URL для допоміжного бекенду на Node.js (наприклад, для WebSocket або мікросервісу)
VITE_NODE_SERVICE_URL=http://localhost:3001/api


# =================================================================
#           BACKEND (Java Spring Boot)
# =================================================================
# Ці змінні будуть використовуватися у файлі application.properties або application.yml

# Порт, на якому буде працювати Spring Boot сервіс
SERVER_PORT=8080

# --- Налаштування бази даних (приклад для PostgreSQL) ---
# Якщо ви використовуєте іншу базу, змініть ці рядки (наприклад, для MySQL, MongoDB)
DB_URL=jdbc:postgresql://localhost:5432/hackathon_db
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# --- Налаштування безпеки (JWT) ---
# Дуже довгий і випадковий рядок для підпису JWT токенів
JWT_SECRET=your-super-long-and-secret-jwt-key-that-no-one-should-guess
# Час життя токену (наприклад, 24 години в мілісекундах)
JWT_EXPIRATION_MS=86400000

# --- Налаштування CORS ---
# URL вашого фронтенду, з якого дозволено робити запити
ALLOWED_ORIGINS=http://localhost:5173


# =================================================================
#           BACKEND (Node.js / Express)
# =================================================================

# Порт, на якому буде працювати Node.js сервіс
PORT=3001

# --- Налаштування бази даних (приклад для MongoDB Atlas) ---
# Якщо цей сервіс також підключається до бази даних
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/myFirstDatabase?retryWrites=true&w=majority

# --- Налаштування безпеки (JWT) ---
# Має бути ТАКИМ САМИМ, як і в Spring Boot, якщо обидва сервіси працюють з одними токенами
JWT_SECRET=your-super-long-and-secret-jwt-key-that-no-one-should-guess
JWT_EXPIRATION=24h

# --- Налаштування CORS ---
# URL вашого фронтенду
ALLOWED_ORIGINS=http://localhost:5173